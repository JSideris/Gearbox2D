{
	"compilerOptions": {
	  "target": "es6",
	  "module": "ES2015",
	  "outDir": "./dist/js",
	  "rootDir": "./typescript/src",
	  "baseUrl": ".",
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "strict": false,
	  "sourceMap": true,
	  "declaration": true,
	  "paths": {
		"@wasm/*": ["dist/wasm/*"]
	  },
	  "resolveJsonModule": true,
	  "moduleResolution": "node"
	},
	"include": ["typescript/src/**/*"],
	"exclude": ["node_modules", "dist"]
  }