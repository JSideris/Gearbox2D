{
  "name": "gearbox2d",
  "version": "0.1.0",
  "description": "A 2D physics engine with TypeScript interface and WebAssembly core",
  "main": "dist/js/gearbox.js",
  "types": "dist/js/gearbox.d.ts",
  "scripts": {
    "clean": "rimraf dist/js",
    "build:ts": "tsc",
    "build:cpp": "make wasm -B",
    "build:standalone": "node scripts/build-standalone.js",
    "build": "npm run build:cpp && npm run build:ts && npm run build:standalone",
    "dev": "tsc --watch",
    "test:ts": "jest --config jest.config.js",
    "test:cpp": "make test -B",
    "test": "npm run test:cpp && npm run test:ts",
    "examples": "vite",
    "examples:build": "vite build",
    "start": "vite",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSideris/Gearbox2D.git"
  },
  "files": [
    "dist/js",
    "dist/wasm",
    "dist/standalone",
    "typescript/src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "physics",
    "engine",
    "2d",
    "webassembly",
    "typescript",
    "game",
    "simulation",
    "rigid body",
    "tool",
    "wasm"
  ],
  "author": "Joshua Sideris",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JSideris/Gearbox2D/issues"
  },
  "homepage": "https://github.com/JSideris/Gearbox2D#readme",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "jest": "^29.5.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
